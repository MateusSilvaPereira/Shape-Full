DATABASE_URL="postgresql://fitness:fitness_dev@localhost:5432/fitness360?schema=public"
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
GEMINI_API_KEY=""

# Envio de e-mail (boas-vindas e recuperação de senha). Opcional: sem isso
# preenchido, o sistema funciona normalmente mas só registra no log.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Armazenamento de imagens via Supabase Storage. Opcional em dev (cai para
# disco local), mas necessário em produção para as imagens não se perderem.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"
